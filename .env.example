# Copy to .env and adjust. docker-compose reads these too.

# Postgres connection string.
DATABASE_URL=postgres://veilproof:veilproof@localhost:5432/veilproof

# Address the HTTP API binds to.
VEILPROOF_BIND=0.0.0.0:8080

# Directory holding pk.bin/vk.bin from `veilproof-keygen`. If unset, the server
# uses the INSECURE deterministic development setup (fine for local dev only).
# VEILPROOF_KEYS_DIR=./keys

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info,veilproof_server=debug
