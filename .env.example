# Copy to .env and adjust. docker-compose reads these too.

# Postgres connection string.
DATABASE_URL=postgres://veilproof:veilproof@localhost:5432/veilproof

# Address the HTTP API binds to.
VEILPROOF_BIND=0.0.0.0:8080

# --- Trusted setup ---------------------------------------------------------
# Where the Groth16 keys come from. Precedence: URL, then DIR, then the
# INSECURE deterministic development setup (fine for local dev only).

# A base URL serving pk.bin and vk.bin, fetched at boot. This is the practical
# option for hosted deployments: the keys stay out of the image and out of git.
# A proving key is public, so serving it over HTTPS is fine.
# VEILPROOF_KEYS_URL=https://github.com/veilproof/veilproof-server/releases/download/keys-testnet

# A directory holding pk.bin/vk.bin from `veilproof-keygen`.
# VEILPROOF_KEYS_DIR=./keys

# Expected SHA-256 of the verifying key. When set, the server refuses to start
# unless its setup is the one the on-chain circuit was registered with. Without
# it the fallback above is silent: the server looks healthy while every proof it
# produces is rejected by the contract. Print it with `veilproof-vk <keys-dir>`.
# VEILPROOF_VK_SHA256=

# How many proofs may be generated at once. Proving is unauthenticated and
# costs seconds of CPU per call, so an unbounded queue is a denial-of-service
# waiting to happen. Beyond this, /prove answers 503 with Retry-After instead
# of queueing. Default 2; raise it only with cores to match.
# VEILPROOF_MAX_CONCURRENT_PROOFS=2

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info,veilproof_server=debug
